@model IEnumerable<TalleresRMP.Models.Mantenimiento>
@{
    ViewData["Title"] = "Lista de Mantenimientos";
    int pagina = ViewBag.Pagina;
    int totalPaginas = ViewBag.TotalPaginas;
    int total = ViewBag.Total;
    string placa = ViewBag.Placa;
    string desde = ViewBag.Desde;
    string hasta = ViewBag.Hasta;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="text-rmp mb-0">Lista de Mantenimientos</h1>
    <a class="btn btn-rmp" asp-action="Create">+ Nuevo Mantenimiento</a>
</div>

@* Filtros *@
<form method="get" asp-action="Index" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label class="form-label mb-1 small">Placa</label>
        <input type="text" name="placa" value="@placa" class="form-control form-control-sm" placeholder="Buscar placa..." style="width:130px;" />
    </div>
    <div class="col-auto">
        <label class="form-label mb-1 small">Desde</label>
        <input type="date" name="desde" value="@desde" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <label class="form-label mb-1 small">Hasta</label>
        <input type="date" name="hasta" value="@hasta" class="form-control form-control-sm" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-rmp btn-sm">Filtrar</button>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Limpiar</a>
    </div>
    <div class="col-auto ms-auto align-self-end">
        <span class="text-muted small">@total registro(s)</span>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">No se encontraron mantenimientos.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="thead-rmp">
                <tr>
                    <th style="width:90px;">Fecha</th>
                    <th style="width:70px;">Número</th>
                    <th style="width:90px;">Placa</th>
                    <th style="width:120px;">Marca</th>
                    <th style="width:120px;">Modelo</th>
                    <th style="width:65px;">KM</th>
                    <th>Descripción</th>
                    <th class="text-end" style="width:100px;">Acciones</th>
                </tr>
            </thead>
            <tbody id="tbodyMantenimientos">
                @foreach (var m in Model)
                {
                    <tr>
                        <td>@m.FechaCreacion.ToString("dd/MM/yyyy")</td>
                        <td>@m.Numero</td>
                        <td>@m.Placa</td>
                        <td>@m.Marca</td>
                        <td>@m.Modelo</td>
                        <td>@m.KM</td>
                        <td style="overflow:hidden;white-space:nowrap;text-overflow:ellipsis;" title="@m.Descripcion">
                            @(m.Descripcion?.Length > 60 ? m.Descripcion[..60] + "…" : m.Descripcion)
                        </td>
                        <td class="text-end">
                            <a class="btn btn-sm btn-outline-success" asp-action="Details" asp-route-id="@m.IdMantenimiento">Ver</a>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@m.IdMantenimiento">Editar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* Paginación *@
    @if (totalPaginas > 1)
    {
        <nav>
            <ul class="pagination pagination-sm justify-content-center">
                <li class="page-item @(pagina <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-placa="@placa" asp-route-desde="@desde" asp-route-hasta="@hasta"
                       asp-route-pagina="@(pagina - 1)">‹</a>
                </li>

                @for (int p = 1; p <= totalPaginas; p++)
                {
                    <li class="page-item @(p == pagina ? "active" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-placa="@placa" asp-route-desde="@desde" asp-route-hasta="@hasta"
                           asp-route-pagina="@p">@p</a>
                    </li>
                }

                <li class="page-item @(pagina >= totalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-placa="@placa" asp-route-desde="@desde" asp-route-hasta="@hasta"
                       asp-route-pagina="@(pagina + 1)">›</a>
                </li>
            </ul>
        </nav>
    }
}
